{
  "name": "cat-care-beta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm test && wrangler deploy",
    "deploy:notest": "wrangler deploy",
    "db:init": "wrangler d1 execute cat-care-beta --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute cat-care-beta --local --file=./schema.sql",
    "test": "node --test test/*.test.js test/*.test.mjs"
  },
  "devDependencies": {
    "jsqr": "1.4.0",
    "qrcode-generator": "2.0.4",
    "wrangler": "^4.0.0"
  }
}
